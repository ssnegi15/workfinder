NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

FIREBASE_PROJECT_ID=
# Use Application Default Credentials in deployment. Set this locally to an
# ignored service-account file path; never commit the credential file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

WORKFINDER_LLM_BASE_URL=http://127.0.0.1:11434/v1
WORKFINDER_LLM_MODEL=qwen3:8b
WORKFINDER_LLM_API_KEY=ollama

WORKFINDER_AGENT_PER_MINUTE_LIMIT=6
WORKFINDER_AGENT_DAILY_REQUEST_LIMIT=40
WORKFINDER_AGENT_DAILY_TOKEN_LIMIT=180000
WORKFINDER_AGENT_TOKEN_RESERVATION=32000
WORKFINDER_SESSION_EXCHANGE_PER_MINUTE_LIMIT=6
WORKFINDER_AGENT_GLOBAL_PER_MINUTE_LIMIT=120
WORKFINDER_AGENT_GLOBAL_DAILY_REQUEST_LIMIT=200
WORKFINDER_AGENT_GLOBAL_DAILY_TOKEN_LIMIT=1000000

# Set this when running behind a reverse proxy, for example https://workfinder.example.com
# WORKFINDER_ALLOWED_ORIGIN=